{
  "name": "opencode-limits-go",
  "version": "2.0.0",
  "description": "OpenCode Go usage limits (5h / 1w / 1m) for OpenCode TUI and Desktop GUI",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "limits",
    "quota"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cusvv/opencode-limits-go.git"
  },
  "homepage": "https://github.com/cusvv/opencode-limits-go#readme",
  "bugs": {
    "url": "https://github.com/cusvv/opencode-limits-go/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "SPEC.md",
    "LICENSE",
    "tsconfig.json",
    "tsconfig.gui.json",
    "vite.config.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.gui.json",
    "test": "node --experimental-strip-types --test src/core/*.test.ts src/server/*.test.ts src/ui-state/*.test.ts src/present/*.test.ts",
    "build": "npm run typecheck && vite build"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@opentui/solid": "^0.9.2",
    "effect": "4.1.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "^0.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
